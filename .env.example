# ==========================================
# Frontend Environment Variables (.env)
# ==========================================
VITE_PROD_URL_BACKEND=http://localhost:8000
VITE_PROD_URL_FRONTEND=http://localhost:5173

# Delta Auth (DAuth) - Frontend Client Config
# Register your client at https://auth.delta.nitt.edu
VITE_DAUTH_CLIENT_ID=your_dauth_client_id_here
VITE_DAUTH_REDIRECT_URI=http://localhost:5173/login

# Auth Method Toggles (Enable/Disable login options)
VITE_ENABLE_DAUTH=true
VITE_ENABLE_EMAIL_AUTH=true

# ==========================================
# Backend Environment Variables (backend/.env)
# ==========================================
PORT=8000
PG_URL=postgresql://user:password@localhost:5432/transfinitte
JWT_SECRET=tf-register-secret-key-2025
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
TEAM_CAP=50
PAYMENT_AMOUNT=200

# Delta Auth (DAuth) - Backend OAuth Credentials
DAUTH_CLIENT_ID=your_dauth_client_id_here
DAUTH_CLIENT_SECRET=your_dauth_client_secret_here
DAUTH_REDIRECT_URI=http://localhost:5173/login

# Cashfree Payment Gateway (Optional / Prod)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=PRODUCTION
CASHFREE_API_VERSION=2023-08-01